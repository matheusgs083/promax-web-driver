# Configuracoes para rodar este promax-web-driver como worker remoto.
# Copie estas linhas para o .env local do PC que vai executar o worker.

# API central do bot_api.
PROMAX_API_BASE_URL=http://IP-DO-SERVIDOR:8080
PROMAX_WORKER_TOKEN=token-configurado-no-bot-api
PROMAX_WORKER_ID=worker-nome-do-pc-ou-revenda

# Opcional. Normalmente nao precisa preencher quando o worker roda desta pasta.
# PROMAX_DRIVER_DIR=C:\Users\SEU_USUARIO\Documents\promax-web-driver
# PROMAX_PYTHON=C:\Users\SEU_USUARIO\Documents\promax-web-driver\venv\Scripts\python.exe

# Credenciais Promax deste PC/usuario.
PROMAX_USER=usuario_promax
PROMAX_PASS=senha_promax
